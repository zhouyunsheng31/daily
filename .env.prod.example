# ============================================================================
# Daily 生产环境配置模板（Phase S15）
# 复制为 .env.prod 并填入真实值；.env.prod 不入 git
# ============================================================================

# PostgreSQL 配置
POSTGRES_USER=daily
# 生成强密码：openssl rand -base64 24
POSTGRES_PASSWORD=<填入强密码>
POSTGRES_DB=daily
PG_PORT=5432
# 服务器上 PostgreSQL 数据卷路径
PGDATA_HOST_PATH=/root/daily/data/pgdata

# 服务器配置
SERVER_PORT=3456
# 共享 token（桌面/移动端连接需携带相同值）
# 生成：openssl rand -hex 32
SERVER_TOKEN=<填入 32+ 字符随机串>

# Pi Agent 配置
PI_MODEL=stepfun/step-3.7-flash
PI_API_KEY=<填入 StepFun API Key>
PI_API_ENDPOINT=https://api.stepfun.com/step_plan/v1
STEPFUN_API_KEY=<填入 StepFun API Key>

# ============================================================================
# Phase S11: Web 端认证
# ============================================================================

# Web 端登录密码（生产必填，长度 >= 8）
WEB_ACCESS_PASSWORD=<填入登录密码>

# JWT 签名 secret（生产必填，长度 >= 32）
# 生成：openssl rand -hex 32
JWT_SECRET=<填入 32+ 字符随机串>

# CORS 白名单（生产域名，逗号分隔，禁止用 *）
CORS_ORIGIN=https://shadowshub.xyz

# Web 构建产物目录
WEB_PUBLIC_DIR=./public

# ============================================================================
# webOS P0: DeepSeek Provider（仅服务端读取，禁止放入 VITE_* / 前端 bundle）
# ============================================================================

# 必填：DeepSeek API Key（用于 /webos/api/chat/stream 对话与 App 生成）
DEEPSEEK_API_KEY=<填入 DeepSeek API Key>

# 可选：覆盖默认模型（pi 内置 provider 名/模型名，默认 deepseek/deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek/deepseek-v4-flash
# 思考深度：DeepSeek 官方四档 low/medium/high/max，由 pi AgentSession 直接映射，
# 无需配置 chat/reasoner 模型拆分或自定义端点。

# ============================================================================
# webOS P0: MiniMax-M3 视觉桥接（2026-08-14，AI 的眼睛）
# ============================================================================
# DeepSeek 无视觉。用户消息中的图片/视频、或 AI 读取的图片文件，自动调用
# MiniMax-M3 转文字描述后再进入对话；用量落 webos_vision_usage 表，
# 管理后台「视觉模型」页实时查看消耗（官方五折价：输入 ¥2.1 / 输出 ¥8.4 每百万）。
# 未配置时视觉桥接自动跳过，对话不受影响。

# 必填（启用视觉桥接）：MiniMax 开放平台 API Key
MINIMAX_API_KEY=<填入 MiniMax API Key>
# 可选：覆盖视觉模型名（默认 MiniMax-M3）
# MINIMAX_VISION_MODEL=MiniMax-M3
# 可选：公网基础地址（本地 API URL 转 M3 可拉取的公网 URL；默认 https://shadowshub.xyz）
# WEBOS_PUBLIC_BASE_URL=https://shadowshub.xyz

# 数据卷挂载路径（服务器）
DATA_HOST_PATH=/root/daily/data
