{
  "name": "daily-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrateFromSqlite.ts",
    "rebuild:electron": "npx electron-rebuild -f -w better-sqlite3 -m .",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration",
    "test:coverage": "vitest run --coverage",
    "ci-test": "node scripts/ci-test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.79.10",
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.0.1",
    "fast-xml-parser": "^4.5.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.0",
    "typebox": "^1.1.38",
    "uuid": "^11.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.2.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
