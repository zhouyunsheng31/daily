{
  "name": "event",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "build:win": "npm run build && electron-builder --win",
    "build:unpack": "npm run build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run client/desktop/electron/main/__tests__/ipc.integration.test.ts client/desktop/src/stores/__tests__/stateMachine.integration.test.ts client/desktop/src/stores/__tests__/apiConfig.integration.test.ts",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:dev": "playwright test --config=e2e/playwright.config.ts e2e/dev-smoke.spec.ts",
    "test:e2e:legacy": "node e2e/phase11-dev-server.mjs",
    "test:coverage": "vitest run --coverage",
    "build:skills": "node scripts/build-skills.mjs",
    "build:all": "npm run build && npm run build:skills"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.79.10",
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "katex": "^0.16.11",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
