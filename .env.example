# ============================================================================
# Daily Phase 3 环境变量配置
# ============================================================================

# PostgreSQL 配置
POSTGRES_USER=daily
POSTGRES_PASSWORD=daily
POSTGRES_DB=daily
PG_PORT=5432
# PostgreSQL 数据卷挂载路径（非 C 盘）
PGDATA_HOST_PATH=F:/allmylife/event/data/pgdata

# 服务器配置
SERVER_PORT=3456
# 系统时区（北京时间）
TZ=Asia/Shanghai
# 共享 token（客户端连接需要携带，为空则不启用认证）
SERVER_TOKEN=

# Pi Agent 配置
PI_MODEL=stepfun/step-3.7-flash
# Pi API Key（优先级高于 STEPFUN_API_KEY，支持多 provider）
PI_API_KEY=
# Pi API Endpoint（可选，自定义 API 入口地址，留空则使用 provider 默认）
PI_API_ENDPOINT=
# webOS P0 Provider（仅服务端读取；严禁写入前端、Git 或浏览器）
# 2026-08-31 起为「引导/兜底」：运行后统一以管理后台「模型管理」的模型目录
# （ai_models）为单一来源，可在线改 provider/apiKey/endpoint/默认模型，无需改部署文件。
DEEPSEEK_API_KEY=
# 可选：覆盖默认模型（pi 内置 provider 名/模型名，默认 deepseek/deepseek-v4-flash）
DEEPSEEK_MODEL=
# 可选：覆盖 API 基础地址（默认 https://opencode.ai/zen/go/v1；走聚合网关时填网关地址，
# 如 ChatST https://api.chatst.org/v1（模型 deepseek-v4-flash-0731）、
# opencode.ai https://opencode.ai/zen/go/v1 或火山方舟 Ark
# https://ark.cn-beijing.volces.com/api/plan/v3（模型 deepseek-v4-flash，key 形如 ark-*））
DEEPSEEK_BASE_URL=
# 重要：模型目录（管理后台「模型管理」）里的自定义 provider，其 key 是对话（AgentSession）
# 自动使用的；但「会话标题生成」（pi completeSimple）不会自动取目录 key，只会读
# options.apiKey 或 <PROVIDER>_API_KEY 环境变量。因此自定义 provider 需在 server/.env
# 再配一份 <PROVIDER>_API_KEY，否则标题生成报「No API key for provider: <provider>」。
# 例：目录 provider=opencode（端点 Ark）→ 需配 OPENCODE_API_KEY=ark-xxx
# OPENCODE_API_KEY=

# Exa 搜索（2026-08-17 接入，替换秘塔/GitHub 搜索）：web_search/read_webpage/exa_find_similar
# 底层走 Exa（api.exa.ai）；预充值 pay-as-you-go（$7/1k 搜索）。仅服务端读取，禁止写入前端/Git/日志。
EXA_API_KEY=

# MiniMax-M3 视觉桥接（2026-08-14，AI 的眼睛）：DeepSeek 无视觉，用户消息中的
# 图片/视频或 AI 读取的图片文件自动调 M3 转文字描述；用量落 webos_vision_usage，
# 管理后台「视觉模型」页实时查看消耗（官方五折价：输入 ¥2.1 / 输出 ¥8.4 每百万 token）。
# 仅服务端读取，禁止写入前端/Git/日志；未配置时视觉桥接自动跳过（对话不受影响）。
MINIMAX_API_KEY=
# 可选：覆盖视觉模型名（默认 MiniMax-M3）
# MINIMAX_VISION_MODEL=MiniMax-M3
# 可选：公网基础地址（本地 API URL 转 M3 可拉取的公网 URL；默认 https://shadowshub.xyz）
# WEBOS_PUBLIC_BASE_URL=https://shadowshub.xyz

# 2026-08-21 DeepSeek 视觉（AI 的眼睛 · 图片优先）：deepseek-v4-flash-vision-exp
# - 官方端点 https://api.deepseek.com（需官方 key，非 opencode 网关 key）
# - 仅服务端读取，禁止写入前端/Git/日志；未配置时图片视觉回退 MiniMax-M3
DEEPSEEK_VISION_API_KEY=

# 生图渠道（ChatST 聚合网关，2026-08-02 接入；仅服务端读取，禁止写入前端/Git/日志）
# - 模型固定 gpt-image-2-super（管理后台定价：输入 ¥16 / 输出 ¥60 每百万 token）
# - 未配置时生图工具返回 IMAGE_GEN_NOT_CONFIGURED（不伪造成功）
CHATST_IMAGE_API_KEY=
# 可选：覆盖网关地址（默认 https://api.chatst.org/v1）
# CHATST_IMAGE_BASE_URL=https://api.chatst.org/v1

# 可选：游客免费额度与存储配额
WEBOS_GUEST_FREE_BALANCE_MINOR=100
WEBOS_GUEST_STORAGE_LIMIT_BYTES=52428800
WEBOS_AI_ESTIMATE_MINOR_PER_1K=1
WEBOS_AI_COST_MINOR_PER_1K=1


# 客户端配置（.env.local 中配置，不在服务器 .env 中）
# VITE_API_BASE_URL=http://localhost:3456/api
# VITE_WS_URL=ws://localhost:3456/ws
# VITE_SERVER_TOKEN=

# ============================================================================
# Phase S11: Web 端认证
# ============================================================================

# Web 端登录密码（生产必填，长度 >= 8）
WEB_ACCESS_PASSWORD=

# Phase 4.2：管理员名单机制（逗号分隔的用户名列表，如 admin,root,developer）
# - 注册时：用户名匹配此列表的用户自动获得 admin 角色
# - migration 时：为列表中的用户名预创建 admin 账号（密码 = WEB_ACCESS_PASSWORD）
ADMIN_USERNAMES=admin,root,developer

# JWT 签名 secret（生产必填，建议 32+ 字符随机串）
# 生成命令：openssl rand -hex 32
JWT_SECRET=

# Resend 邮件服务（邮箱验证码注册/登录，2026-08-02 接入）
# - 仅服务端读取，禁止写入前端、日志、原型或 Git
# - RESEND_FROM_EMAIL 需是在 Resend 已验证的域名发件地址
# - RESEND_FROM_NAME 可选：发件人显示名（默认 Daily，收件人邮箱列表显示此名而非 no-reply）
# - 注意：Resend 免费额度约 100 封/天（约支持 100 个新注册/天）；接近上限时接口返回
#   EMAIL_DAILY_LIMIT 提示，需要升级 Resend 套餐
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=Daily

# 支付渠道（2026-08-02 zpay 已移除，计划接入爱发电 afdian.com；未接入时购买接口返回
# PAYMENT_UNAVAILABLE，不创建假订单/模拟到账）
# 待接入：AFDIAN_USER_ID= / AFDIAN_TOKEN= 等（见爱发电开放平台文档）
# 爱发电主页（审核要求：在常用平台公开宣传；配置后前端支付页展示「前往爱发电主页」入口）
# AFDIAN_PAGE_URL=https://afdian.com/a/你的主页slug

# CORS 白名单（必填，逗号分隔，禁止用 *）
# 开发：http://localhost:5173
# 生产：https://shadowshub.xyz
CORS_ORIGIN=http://localhost:5173

# Web 构建产物目录（默认 ./public，Docker 构建时打入镜像）
WEB_PUBLIC_DIR=./public
